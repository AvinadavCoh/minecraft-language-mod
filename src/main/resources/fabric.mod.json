{
	"schemaVersion": 1,
	"id": "languagemod",
	"version": "${version}",
	"name": "Say It Or Lose It",
	"description": "Learn a language while you play: say the name of every new item you pick up, or lose it.",
	"contact": {
		"homepage": "https://github.com/AvinadavCoh/minecraft-language-mod",
		"sources": "https://github.com/AvinadavCoh/minecraft-language-mod",
		"issues": "https://github.com/AvinadavCoh/minecraft-language-mod/issues"
	},
	"authors": ["itonk"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.itonk.languagemod.LanguageMod"],
		"client": ["dev.itonk.languagemod.client.LanguageModClient"]
	},
	"mixins": ["languagemod.mixins.json"],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
